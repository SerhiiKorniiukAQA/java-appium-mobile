<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="iOS" verbose="1">
    <listeners>
        <listener class-name="io.github.serhiikorniiuk.mobile.listeners.RetryListener"/>
    </listeners>
    <test name="iOS - UI, E2E, platform">
        <groups>
            <run>
                <exclude name="android-only"/>
            </run>
        </groups>
        <packages>
            <package name="io.github.serhiikorniiuk.mobile.ui"/>
            <package name="io.github.serhiikorniiuk.mobile.e2e"/>
            <package name="io.github.serhiikorniiuk.mobile.platform"/>
        </packages>
    </test>
</suite>
